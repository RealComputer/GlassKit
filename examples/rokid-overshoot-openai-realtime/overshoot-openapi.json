            "API Key": []
          }
        ]
      }
    },
    "/streams/{stream_id}/keepalive": {
      "post": {
        "tags": [
          "streams"
        ],
        "summary": "Keepalive",
        "description": "Renew the stream lease and pay for elapsed streaming time. **Call every 10-20 seconds.** Streams expire after ~45 seconds without a keepalive.\n\nEach call charges for time since the last keepalive. If credits are insufficient (402), the lease is NOT renewed and the stream will expire.\n\nFor native transport, the response includes a refreshed `livekit_token`.",
        "operationId": "keepalive_stream_streams__stream_id__keepalive_post",
        "security": [
          {
            "API Key": []
          }
        ],
        "parameters": [
          {
            "name": "stream_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Stream Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lease renewed, credits charged",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KeepaliveResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
