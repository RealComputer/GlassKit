            "maximum": 10,
            "minimum": 0,
            "title": "Rating",
            "description": "Quality rating from 0 (worst) to 10 (best)"
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "title": "Category",
            "description": "Feedback category (e.g. 'accuracy', 'latency', 'relevance')"
          },
          "feedback": {
            "type": "string",
            "title": "Feedback",
            "description": "Optional free-text feedback",
            "default": ""
