  "components": {
    "schemas": {
      "ClipProcessingConfig": {
        "properties": {
          "target_fps": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 30,
                "exclusiveMinimum": 0
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Fps",
            "description": "Target frames per second for sampling"
          },
          "sampling_ratio": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1,
                "minimum": 0.1
              },
              {
                "type": "null"
              }
            ],
            "title": "Sampling Ratio",
            "description": "Frame sampling ratio (legacy)"
          },
          "fps": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              {
                "type": "null"
              }
            ],
            "title": "Fps",
            "description": "Source frames per second (legacy)"
          },
          "clip_length_seconds": {
            "type": "number",
            "maximum": 60,
            "minimum": 0.1,
            "title": "Clip Length Seconds",
            "description": "Length of each clip in seconds"
          },
          "delay_seconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "title": "Delay Seconds",
            "description": "Processing delay in seconds"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "clip_length_seconds",
          "delay_seconds"
        ],
        "title": "ClipProcessingConfig",
        "description": "Configuration for clip mode: frame sampling and bundling.\n\nAccepts either the new target_fps field or the legacy fps + sampling_ratio\nfields. The model_validator resolves target_fps in both cases."
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "details": {
            "anyOf": [
              {

              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "description": "Error response."
      },
      "FeedbackCreateRequest": {
        "properties": {
          "rating": {
            "type": "integer",
            "maximum": 10,
            "minimum": 0,
            "title": "Rating",
            "description": "Rating from 0 to 10"
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "title": "Category",
            "description": "Feedback category"
          },
          "feedback": {
            "type": "string",
            "title": "Feedback",
            "description": "Detailed feedback text",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "rating",
          "category"
        ],
        "title": "FeedbackCreateRequest",
        "description": "Request to submit feedback for a stream."
      },
      "FeedbackResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "stream_id": {
            "type": "string",
            "title": "Stream Id"
          },
          "rating": {
            "type": "integer",
            "title": "Rating"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "feedback": {
            "type": "string",
            "title": "Feedback"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "updated_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "stream_id",
          "rating",
          "category",
          "feedback",
          "created_at",
          "updated_at"
        ],
        "title": "FeedbackResponse",
        "description": "Stream feedback details."
      },
      "FrameProcessingConfig": {
        "properties": {
          "interval_seconds": {
            "type": "number",
            "maximum": 60,
            "exclusiveMinimum": 0,
            "title": "Interval Seconds",
            "description": "Interval between frame captures in seconds"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "interval_seconds"
        ],
        "title": "FrameProcessingConfig",
        "description": "Configuration for frame mode: single frame capture at intervals."
