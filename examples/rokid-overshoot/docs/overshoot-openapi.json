      "KeepaliveResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "stream_id": {
            "type": "string",
            "title": "Stream Id"
          },
          "ttl_seconds": {
            "type": "integer",
            "title": "Ttl Seconds"
          },
          "credits_remaining_cents": {
            "type": "integer",
            "title": "Credits Remaining Cents"
          },
          "cost_cents": {
            "type": "number",
            "title": "Cost Cents"
          },
          "seconds_charged": {
            "type": "number",
            "title": "Seconds Charged"
          }
        },
        "type": "object",
        "required": [
          "status",
          "stream_id",
          "ttl_seconds",
          "credits_remaining_cents",
          "cost_cents",
          "seconds_charged"
        ],
        "title": "KeepaliveResponse",
        "description": "Response to keepalive request."
      },
      "LiveKitSourceConfig": {
        "properties": {
          "type": {
            "type": "string",
            "const": "livekit",
            "title": "Type"
          },
          "url": {
            "type": "string",
            "minLength": 1,
