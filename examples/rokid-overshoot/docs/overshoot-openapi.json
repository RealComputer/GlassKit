        "title": "StreamCreateRequest",
        "description": "Request to create a new media stream.\n\nAccepts either the new ``source`` field or the legacy ``webrtc`` field.\nIf ``webrtc`` is provided without ``source``, it is automatically\nmapped to ``source: {type: \"webrtc\", sdp: ...}``."
      },
      "StreamCreateResponse": {
        "properties": {
          "stream_id": {
            "type": "string",
            "title": "Stream Id",
            "description": "Unique stream identifier"
          },
          "webrtc": {
            "anyOf": [
